{
  "name": "orbcafe-ui",
  "version": "3.0.0",
  "description": "ORBCAFE UI components — ORBIS brand system, MUI-free",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "style": "./dist/orbis.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/orbis.css",
    "./dist/orbis.css": "./dist/orbis.css",
    "./dist/index.css": "./dist/index.css",
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json",
    "./themes/*": "./dist/themes/*"
  },
  "scripts": {
    "check:ai-contracts": "node scripts/check-ai-contracts.js",
    "check:types": "tsc --noEmit && cd examples && ./node_modules/.bin/tsc --noEmit",
    "check:examples": "npm --prefix examples run lint",
    "docs:build": "node scripts/build-docs-pages.js",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "pack:check": "npm_config_cache=/tmp/.npm-cache npm pack --dry-run",
    "release:check": "npm run check:ai-contracts && npm run check:types && npm run check:examples && npm run docs:build && npm run build && npm run pack:check",
    "publish:npm": "npm publish --access public",
    "publish:npm:token": "./scripts/publish-npm.sh",
    "build:theme": "node scripts/build-theme.mjs"
  },
  "keywords": [
    "react",
    "tailwind",
    "ui"
  ],
  "author": "ORBAI Team",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SHENRUIYANG/orbcafe-ui.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "bin",
    "MIGRATION_V2.md",
    "BRAND_THEMING.md",
    "COMMERCIAL_LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "next": "^13.0.0 || ^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "next": "^16.2.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.0.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "dayjs": "^1.11.19",
    "framer-motion": "^12.35.1",
    "i18next": "^25.8.18",
    "mermaid": "^10.9.0",
    "ogl": "^1.0.11",
    "react-i18next": "^16.5.8",
    "react-markdown": "^9.0.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.10",
    "rollup": "^4.59.0"
  },
  "bin": {
    "orbcafe-theme": "./bin/orbcafe-theme.mjs"
  }
}
